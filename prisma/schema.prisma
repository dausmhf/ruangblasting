datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String       @default("admin")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  settings     UserSettings?
  authSessions AuthSession[]
  knowledge    Knowledge[]
  sessions     Session[]
  messages     Message[]
  memories     UserMemory[]
  broadcasts   Broadcast[]
}

model UserSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  storeName             String   @default("Ruank WhatsApp")
  botName               String   @default("Ruank Assistant")
  starsenderApiKey      String?
  geminiApiKey          String?
  geminiModel           String   @default("gemini-2.5-flash")
  webhookToken          String   @unique
  adminNotificationPhone String?
  operationalStart      String   @default("08:00")
  operationalEnd        String   @default("22:00")
  timezone              String   @default("Asia/Jakarta")
  aiEnabled             Boolean  @default(true)
  autoReplyEnabled      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Knowledge {
  id          String   @id @default(uuid())
  userId      String
  title       String
  tags        String
  content     String
  type        String   @default("general")
  productName String?
  productLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  phoneNumber  String
  displayName  String?
  orderState   String   @default("idle")
  currentOrder String?
  humanMode    Boolean  @default(false)
  archived     Boolean  @default(false)
  unreadCount  Int      @default(0)
  createdAt    DateTime @default(now())
  lastActivity DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneNumber])
  @@index([userId, lastActivity])
}

model Message {
  id        String   @id @default(uuid())
  userId    String
  fromPhone String
  message   String?
  response  String?
  status    String   @default("processing")
  type      String   @default("incoming")
  humanMode Boolean  @default(false)
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fromPhone, timestamp])
  @@index([userId, timestamp])
}

model UserMemory {
  id          String   @id @default(uuid())
  userId      String
  phoneNumber String
  name        String?
  memoryText  String?  @default("")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneNumber])
}

model Broadcast {
  id          String               @id @default(uuid())
  userId      String
  title       String               @default("Campaign")
  message     String?
  imageUrl    String?
  scheduledAt DateTime?
  timezone    String               @default("Asia/Jakarta")
  status      String               @default("draft")
  approvedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  recipients  BroadcastRecipient[]
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledAt])
}

model BroadcastRecipient {
  id           String    @id @default(uuid())
  broadcastId  String
  groupId      String
  groupName    String
  status       String    @default("pending")
  attempts     Int       @default(0)
  sentAt       DateTime?
  errorMessage String?
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, groupId])
  @@index([broadcastId, status])
}
